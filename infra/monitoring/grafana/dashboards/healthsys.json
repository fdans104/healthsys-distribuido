          },
          "expr": "healthsys_mqtt_conectado",
          "legendFormat": "conexão",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "CONECTADOS",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "SEM CONEXÃO",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
